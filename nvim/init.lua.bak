-- ============================================================
-- PLUGINS (lazy.nvim)
-- ============================================================
local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not vim.loop.fs_stat(lazypath) then
  vim.fn.system({ "git", "clone", "--filter=blob:none",
    "https://github.com/folke/lazy.nvim.git", "--branch=stable", lazypath })
end
vim.opt.rtp:prepend(lazypath)

require("lazy").setup({
  -- Themes
  { "joshdick/onedark.vim" },
  { "sainnhe/sonokai" },

  -- UI
  { "preservim/nerdtree",                  cmd = { "NERDTree", "NERDTreeToggle", "NERDTreeFind", "NERDTreeFocus" } },
  { "tiagofumo/vim-nerdtree-syntax-highlight", cmd = { "NERDTree", "NERDTreeToggle", "NERDTreeFind", "NERDTreeFocus" } },
  { "xuyuanp/nerdtree-git-plugin",         cmd = { "NERDTree", "NERDTreeToggle", "NERDTreeFind", "NERDTreeFocus" } },
  { "ryanoasis/vim-devicons" },
  { "Yggdroot/indentLine",                 cmd = "IndentLinesToggle" },

  -- LSP / Completion
  { "neoclide/coc.nvim",                   branch = "release" },

  -- Linting / Formatting
  { "dense-analysis/ale" },
  { "cappyzawa/trim.nvim" },

  -- Editing
  { "jiangmiao/auto-pairs" },
  { "preservim/nerdcommenter" },

  -- Git
  { "airblade/vim-gitgutter",              cmd = "GitGutterEnable" },
  { "tpope/vim-fugitive" },

  -- Language support
  { "andrewstuart/vim-kubernetes",         ft = { "yaml", "yml" } },
  { "cespare/vim-toml",                    ft = "toml" },
  { "chr4/nginx.vim",                      ft = "nginx" },
  { "ekalinin/Dockerfile.vim",             ft = "dockerfile" },
  { "fatih/vim-go",                        ft = "go" },
  { "hashivim/vim-terraform",              ft = { "hcl", "terraform", "tf" } },
  { "hashivim/vim-vagrant",                ft = { "vagrant" } },
  { "pearofducks/ansible-vim",             ft = "ansible" },
  { "plasticboy/vim-markdown",             ft = { "markdown", "md" } },
  { "stephpy/vim-yaml",                    ft = { "yaml", "yml" } },
  { "towolf/vim-helm",                     ft = "helm" },
  { "vim-scripts/JSON.vim",               ft = "json" },

  -- Search
  { "junegunn/fzf",                        build = function() vim.fn["fzf#install"]() end },
  { "junegunn/fzf.vim" },
})

-- ============================================================
-- CLIPBOARD (OSC52 — funciona em SSH + tmux + Wayland/Konsole)
-- ============================================================
vim.g.clipboard = {
  name = "OSC52",
  copy = {
    ["+"] = require("vim.ui.clipboard.osc52").copy("+"),
    ["*"] = require("vim.ui.clipboard.osc52").copy("*"),
  },
  paste = {
    ["+"] = require("vim.ui.clipboard.osc52").paste("+"),
    ["*"] = require("vim.ui.clipboard.osc52").paste("*"),
  },
}

-- ============================================================
-- BASIC OPTIONS
-- ============================================================
vim.opt.termguicolors  = true
vim.opt.background     = "dark"
vim.opt.title          = true
vim.opt.encoding       = "utf-8"
vim.opt.mouse          = "a"
vim.opt.clipboard      = "unnamedplus"
vim.opt.hidden         = true
vim.opt.confirm        = true
vim.opt.splitbelow     = true
vim.opt.splitright     = true
vim.opt.path           = { ".", "**" }
vim.opt.tags           = { "./tags", "tags;" .. vim.env.HOME }
vim.opt.swapfile       = false
vim.opt.backup         = false
vim.opt.undofile       = true
vim.opt.undodir        = vim.fn.expand("~/.config/nvim/undodir")

vim.opt.wrap           = false
vim.opt.linebreak      = true
vim.opt.list           = false
vim.opt.listchars      = { tab = "›-", space = "·", trail = "◀", eol = "↲" }

vim.opt.number         = true
vim.opt.scrolloff      = 2
vim.opt.cursorline     = true
vim.opt.cursorcolumn   = true

vim.opt.foldmethod     = "syntax"
vim.opt.foldlevel      = 99

vim.opt.autoindent     = true
vim.opt.smartindent    = true
vim.opt.expandtab      = true
vim.opt.tabstop        = 4
vim.opt.softtabstop    = 4
vim.opt.shiftwidth     = 4

vim.opt.smartcase      = true
vim.opt.incsearch      = true
vim.opt.hlsearch       = true
vim.opt.completeopt    = { "menuone", "longest" }
vim.opt.shortmess:append("c")

vim.opt.spelllang      = { "pt_br", "en" }
vim.opt.spell          = false
vim.opt.wildmenu       = true
vim.opt.wildmode       = { "longest", "full" }
vim.opt.wildoptions    = "pum"
vim.opt.showmode       = false
vim.opt.laststatus     = 2

-- Cursor shape (insert = beam, normal = block)
vim.opt.guicursor = "n-v-c:block,i-ci-ve:ver25,r-cr:hor20"

-- Statusline colors
vim.cmd([[
  hi statusline   cterm=NONE ctermfg=0 ctermbg=7   guibg=#C1C2D0 guifg=#000000
  hi statuslinenc cterm=NONE ctermfg=0 ctermbg=240 guibg=#616270 guifg=#000000
]])

-- Transparent background
vim.cmd([[
  highlight Normal guibg=NONE ctermbg=NONE
  highlight EndOfBuffer guibg=NONE ctermbg=NONE
]])

