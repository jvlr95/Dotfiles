-- Markdown
vim.g.vim_markdown_folding_disabled = 1

-- NERDTree
vim.g.NERDTreeMinimalUI          = 1
vim.g.NERDTreeDirArrows          = 0
vim.g.NERDTreeShowHidden         = 0
vim.g.NERDTreeWinSize            = 30
vim.g.NERDTreeShowBookmarks      = 1
vim.g.NERDTreeAutoDeleteBuffer   = 1
vim.g.NERDTreeRespectWildIgnore  = 1
vim.g.NERDTreeIgnore             = {
  "\\.git$", "\\.svn$", "\\.hg$", "\\.DS_Store$",
  "\\.devcontainer$", "\\.vscode$", "__pycache__$",
  "\\.terraform$", "\\.terraform\\.lock\\.hcl$",
  "\\.terragrunt-cache$", "\\.pyc$",
}

-- WebDevIcons
vim.g.WebDevIconsOS                        = "Darwin"
vim.g.webdevicons_enable                   = 1
vim.g.webdevicons_enable_nerdtree          = 1
vim.g.WebDevIconsUnicodeDecorateFileNodes  = 1
vim.g.webdevicons_conceal_nerdtree_brackets = 1
vim.g.WebDevIconsUnicodeDecorateFolderNodes = 1

-- ============================================================
-- AUTOCMDS
-- ============================================================
local ag = vim.api.nvim_create_augroup
local au = vim.api.nvim_create_autocmd

-- Auto-reload init.lua on save
ag("autosourcing", { clear = true })
au("BufWritePost", { group = "autosourcing", pattern = "init.lua", command = "source %" })

-- CoC: show documentation with K
local function show_documentation()
  local ft = vim.bo.filetype
  if ft == "vim" or ft == "help" then
    vim.cmd("h " .. vim.fn.expand("<cword>"))
  elseif vim.fn["coc#rpc#ready"]() then
    vim.fn.CocActionAsync("doHover")
  else
    vim.cmd("!" .. vim.o.keywordprg .. " " .. vim.fn.expand("<cword>"))
  end
end

-- ============================================================
-- KEYMAPS
-- ============================================================
local map = vim.keymap.set
local opts = { silent = true }

vim.g.mapleader = ","

-- File explorer (NERDTree)
map("n", "<C-e>e", ":NERDTreeToggle<CR>",  opts)  -- toggle NERDTree
map("n", "<C-e>f", ":NERDTreeFind<CR>",    opts)  -- reveal file in NERDTree

-- Search (FZF)
map("n", "<C-f>d", ":FZF<CR>",  opts)  -- busca de arquivos
map("n", "<C-f>t", ":Ag<CR>",   opts)  -- busca de texto (ripgrep/ag)

-- IDE toggles
map("n", "<C-g>",  ":GitGutterEnable<CR>", opts)   -- ativa git gutter
map("n", "<C-d>",  ":below terminal<CR>",  opts)   -- abre terminal abaixo

-- Buffer / tab navigation
map("n", "<leader>t", ":tabnew<CR>",  opts)  -- nova aba
map("n", "<leader>n", ":bnext<CR>",   opts)  -- próximo buffer
map("n", "<leader>p", ":bprev<CR>",   opts)  -- buffer anterior

-- CoC: navigation
map("n", "gd", "<Plug>(coc-definition)",      opts)  -- vai para definição
map("n", "gy", "<Plug>(coc-type-definition)", opts)  -- vai para tipo
map("n", "gi", "<Plug>(coc-implementation)", opts)   -- vai para implementação
map("n", "gr", "<Plug>(coc-references)",      opts)  -- referências
map("n", "<leader>rn", "<Plug>(coc-rename)",      opts)  -- renomear símbolo
map("n", "<leader>ca", "<Plug>(coc-codeaction)",  opts)  -- code action
map("n", "K", show_documentation, opts)                  -- documentação

-- CoC: completion
map("i", "<C-Space>", "coc#refresh()", { silent = true, expr = true })
map("i", "<CR>", [[pumvisible() ? coc#_select_confirm() : "\<C-g>u\<CR>\<C-r>=coc#on_enter()\<CR>"]],
  { silent = true, expr = true })

-- Git (fugitive)
map("n", "<leader>gs", ":Git<CR>",         opts)  -- git status
map("n", "<leader>gd", ":Gvdiffsplit<CR>", opts)  -- git diff (vertical)
map("n", "<leader>gl", ":Gclog<CR>",       opts)  -- git log

-- Quick toggles
map("n", "<leader>i", ":IndentLinesToggle<CR>", opts)  -- toggle indent guides
